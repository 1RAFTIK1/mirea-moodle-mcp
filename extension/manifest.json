{
  "manifest_version": 3,
  "name": "МИРЭА Moodle → MCP",
  "short_name": "Moodle MCP",
  "version": "0.2.0",
  "description": "Передаёт сессию online-edu.mirea.ru локальному mirea-moodle-mcp: кнопка «Подключить», автообновление после входа и ближайшие дедлайны.",
  "key": "",
  "permissions": ["cookies", "nativeMessaging", "storage", "alarms"],
  "host_permissions": ["https://online-edu.mirea.ru/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Moodle MCP", "default_popup": "popup.html" },
  "minimum_chrome_version": "110"
}
